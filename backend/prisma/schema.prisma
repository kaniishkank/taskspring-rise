generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  role          Role
  department    String?
  active        Boolean        @default(true)
  avatar        String?
  password      String?
  tasksOwned    Task[]         @relation("AssignedBy")
  tasksToDo     Task[]         @relation("AssignedTo")
  comments      Comment[]
  submissions   Submission[]
  notifications Notification[]
  fcmToken      String?
  calendarToken String         @unique @default(cuid())
  phoneNumber   String?
  notifyWhatsApp Boolean       @default(true)
  notifyAssignments Boolean @default(true)
  notifyDeadlines   Boolean @default(true)
  notifyApprovals   Boolean @default(true)
  notifyWeekly      Boolean @default(true)
}

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String
  priority      String
  status        String       @default("assigned")
  assignedTo    User         @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedToId  String
  assignedBy    User         @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedById  String
  createdAt     DateTime     @default(now())
  dueDate       DateTime
  extendedDueDate DateTime?
  attachments   String       @default("[]")
  comments      Comment[]
  submissions   Submission[]
  notifications Notification[]

  @@index([status])
  @@index([assignedToId])
  @@index([assignedById])
}

model Comment {
  id      String   @id @default(cuid())
  task    Task     @relation(fields: [taskId], references: [id])
  taskId  String
  user    User     @relation(fields: [userId], references: [id])
  userId  String
  text    String
  at      DateTime @default(now())
}

model Submission {
  id      String   @id @default(cuid())
  task    Task     @relation(fields: [taskId], references: [id])
  taskId  String
  user    User     @relation(fields: [userId], references: [id])
  userId  String
  at      DateTime @default(now())
  notes   String
  files   String   @default("[]")
  links   String   @default("[]")
  status  String
  feedback String?
}

model Notification {
  id                String   @id @default(cuid())
  title             String
  message           String
  category          String
  read              Boolean  @default(false)
  notifiedOnStartup Boolean  @default(false)
  at                DateTime @default(now())
  user              User?    @relation(fields: [userId], references: [id])
  userId            String?
  task              Task?    @relation(fields: [taskId], references: [id])
  taskId            String?
}

enum Role {
  OPERATION
  MANAGER
  STAFF
}
